DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=10
LLM_TOTAL_TIMEOUT_SECONDS=35
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.25
DATABASE_URL=sqlite:///../../output/sap_blueprint.db
DATABASE_AUTO_CREATE=true
KNOWLEDGE_ROOT=
